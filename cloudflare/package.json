{
  "name": "@kanthorlabs/assets-cloudflare",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite dev --port 8787 --strictPort --no-cors",
    "build": "cf build",
    "typecheck": "cf workers types && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:tooling": "node --test test-tools/*.test.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:tooling && pnpm run build",
    "deploy": "node scripts/deploy.ts",
    "preflight": "node scripts/preflight.ts",
    "test:e2e": "node scripts/e2e.ts",
    "fixtures": "node scripts/fixtures.ts",
    "sync-secrets": "node scripts/sync-secrets.ts"
  },
  "dependencies": {
    "@kanthorlabs/assets-core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-auth": "0.9.4",
    "@types/node": "24.12.0",
    "cf": "1.0.0-beta.5",
    "marked": "18.1.3",
    "pdf-lib": "1.17.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.9"
  }
}

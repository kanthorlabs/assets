{
  "rules": [
    {
      "description": "assets: serve HTML unchanged",
      "expression": "http.host eq \"assets.kanthorlabs.com\"",
      "action": "set_config",
      "action_parameters": {
        "email_obfuscation": false,
        "automatic_https_rewrites": false,
        "server_side_excludes": false
      },
      "enabled": true
    }
  ]
}
